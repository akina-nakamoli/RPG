  quests:
  - id: town_goblin_01
    title: Goblin Hunt
    description: Goblins are threatening travelers near the village. Help the town make the roads safe again.
    objective: Defeat 3 Goblins.
  - id: town_mushroom_01
    title: Mushroom Gathering
    description: The village kitchen is running low on fresh mushrooms.
    objective: Collect 5 Mushrooms for the kitchen.
  - id: town_wood_01
    title: Timber Supplies
    description: The town builders need timber to repair the village fence.
    objective: Collect 10 Wood for the town.
  - id: town_meat_01
    title: Meat Supplies
    description: The village cook needs fresh meat for the town feast.
    objective: Collect 3 Meat for the village.
